<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>03. Custom Block Colours (Blocks only)</name>
  <id>org.quilttoolsplugin.quilttools_custom_colours</id>
  <dependency type="executable" location="extensions">quilttools_custom_colours.py</dependency>

  <label appearance="header">Permanent colour memory &amp; Canvas Display of a BLOCK</label>
  <label>BLOCKS ONLY: these actions edit the block's saved colours and canvas display properties. On a quilt layout, use 00. Fabric Palette or 02. Colour Randomiser.</label>

  <param name="action" type="optiongroup" appearance="combo" gui-text="Action">
    <option value="save_colors">Save Canvas Colors &amp; Apply Display Settings</option>
    <option value="set_display">Apply Display Settings Only (Opacity, Seam Allowance, Grouping)</option>
    <option value="sample_image">Sample Fabric Colors from Traced Image</option>
    <option value="quantize">Quantize Colors to N Fabrics</option>
    <option value="export_palette">Export Block Colors as Inkscape Palette</option>
    <option value="clear_colors">Clear Custom Colors (Permanently delete all saved colors, revert to default)</option>
  </param>

  <separator/>
  <label appearance="header">Display &amp; Canvas Preferences</label>
  <param name="fill_opacity" type="float" min="0.0" max="1.0" precision="2" gui-text="Block Fill Opacity (0.0 = transparent, 1.0 = solid)">1.0</param>
  <param name="show_sa" type="bool" gui-text="Show Seam Allowances on Canvas">false</param>
  <param name="sa_in" type="float" min="0.125" max="1.0" precision="3" gui-text="Seam Allowance Size (inches)">0.25</param>
  <param name="group_by_color" type="bool" gui-text="Group Canvas Objects by Fabric Color">false</param>

  <separator/>
  <label appearance="header">Quantize / Palette Settings</label>
  <param name="quantize_n" type="int" min="1" max="24" gui-text="Target Number of Fabrics (N)">6</param>
  <param name="locked_colors" type="string" gui-text="Locked Fabric Colors (Comma-separated hex; selection is also locked)"></param>
  <param name="color_code_overrides" type="string" gui-text="Custom Color Codes (e.g. #678967:FAB1, #ffffff:BG)"></param>

  <separator/>
  <label>Tip: Toggle between your block colours and section overlay anytime with: Quilt Tools Block &gt; 05. FPP Display Toggle.</label>

  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Quilt Tools Colour"/>
    </effects-menu>
  </effect>
  <script><command location="extensions" interpreter="python">quilttools_custom_colours.py</command></script>
</inkscape-extension>
