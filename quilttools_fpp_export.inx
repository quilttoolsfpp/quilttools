<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>13. Block Pattern Export</name>
  <id>org.quilttoolsplugin.quilttools_fpp_export</id>
  <dependency type="executable" location="extensions">quilttools_fpp_export.py</dependency>

  <param name="action" type="optiongroup" appearance="combo" gui-text="Workflow Step">
    <option value="step1">Step 1: Generate Canvas for Manual Layout (Open Canvas)</option>
    <option value="step2">Step 2: Render PDF Patterns (Smart Pack or Finalize Manual Layout)</option>
  </param>

  <label>Choose your export workflow tab below. Margins, metadata credits, and page setups will appear in a separate setup dialog when you click Apply.</label>

  <param name="notebook" type="notebook">
    <page name="fpp_tab" gui-text="1. FPP Export">
      <label appearance="header">Foundation Paper Piecing (FPP) Settings</label>
      <label>Export this block as an FPP pattern. Pieces will be grouped by section (A, B, etc.) and printed together.</label>
      <param name="finished_size_in_fpp" type="float" min="0.0" max="200.0" precision="1" gui-text="Finished Block Size (inches) [0.0 = As Sized]">0.0</param>
      <param name="finished_sizes_fpp" type="string" gui-text="Additional Sizes (Step 2 Smart Pack only, e.g. 6,10)"></param>
      <param name="template_copies_fpp" type="int" min="1" max="50" gui-text="Template Copies (Sets per size)">1</param>
    </page>

    <page name="template_tab" gui-text="2. Pattern Template Export">
      <label appearance="header">Individual Template Settings</label>
      <label>Export this block as individual paper templates. Every fabric piece is printed as an individual template shape.</label>
      <param name="finished_size_in_temp" type="float" min="0.0" max="200.0" precision="1" gui-text="Finished Block Size (inches) [0.0 = As Sized]">0.0</param>
      <param name="finished_sizes_temp" type="string" gui-text="Additional Sizes (Step 2 Smart Pack only, e.g. 6,10)"></param>
      <param name="template_copies_temp" type="int" min="1" max="50" gui-text="Template Copies (Sets per size)">1</param>
      <param name="template_dedupe_temp" type="optiongroup" appearance="combo" gui-text="Duplicate Templates">
        <option value="all">Print a template for every piece</option>
        <option value="unique">Print one template per unique shape (marked 'cut N')</option>
      </param>
      <param name="squares_cutting_list_only_temp" type="bool" gui-text="Squares/rectangles: cutting list only, no printed template">false</param>
    </page>

    <page name="mixed_tab" gui-text="3. Mixed Technique Export">
      <label appearance="header">Mixed Technique &amp; Template Settings</label>
      <label>Export this block using mixed techniques. Pieces marked for batch techniques (like HSTs or stitch-and-flip) are cut using math guides (no paper templates printed), while other pieces print normally.</label>
      <param name="finished_size_in_mixed" type="float" min="0.0" max="200.0" precision="1" gui-text="Finished Block Size (inches) [0.0 = As Sized]">0.0</param>
      <param name="finished_sizes_mixed" type="string" gui-text="Additional Sizes (Step 2 Smart Pack only, e.g. 6,10)"></param>
      <param name="template_copies_mixed" type="int" min="1" max="50" gui-text="Template Copies (Sets per size)">1</param>
      <param name="template_dedupe_mixed" type="optiongroup" appearance="combo" gui-text="Duplicate Templates">
        <option value="all">Print a template for every piece</option>
        <option value="unique">Print one template per unique shape (marked 'cut N')</option>
      </param>
      <param name="squares_cutting_list_only_mixed" type="bool" gui-text="Squares/rectangles: cutting list only, no printed template">false</param>
      <param name="oversize_batch" type="bool" gui-text="Oversize batch units for trimming (HSTs +1&#8221;, geese +&#188;&#8221;)">true</param>
      <param name="hst_templates" type="bool" gui-text="Include HST sewing-line templates">true</param>
    </page>
  </param>

  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Quilt Tools Block"/>
    </effects-menu>
  </effect>
  <script><command location="extensions" interpreter="python">quilttools_fpp_export.py</command></script>
</inkscape-extension>
