<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>02. New Quilt</name>
  <id>org.quilttools.pattern.new_quilt</id>
  <dependency type="executable" location="extensions">quilttools_new_quilt.py</dependency>

  <param name="notebook" type="notebook">
    <page name="grid_page" gui-text="1. Grid &amp; Blocks">
      <param name="quilt_name" type="string" gui-text="Quilt Title:">My New Quilt</param>
      <param name="setting" type="optiongroup" appearance="combo" gui-text="Quilt Setting:">
        <option value="straight">Straight Grid</option>
        <option value="on-point">On-Point (Diamond)</option>
      </param>
      <param name="grid_rows" type="int" min="1" max="100" gui-text="Grid Rows:">4</param>
      <param name="grid_cols" type="int" min="1" max="100" gui-text="Grid Columns:">4</param>
      <param name="cell_w_in" type="float" min="1.0" max="200.0" precision="3" gui-text="Block Width (inches):">12.0</param>
      <param name="cell_h_in" type="float" min="1.0" max="200.0" precision="3" gui-text="Block Height (inches):">12.0</param>
    </page>
    <page name="sashing_page" gui-text="2. Sashing &amp; Borders">
      <param name="sashing_w_in" type="float" min="0.0" max="20.0" precision="3" gui-text="Sashing Width (inches):">0.0</param>
      <param name="cornerstones" type="bool" gui-text="Include Cornerstones (requires sashing):">false</param>
      <separator/>
      <label appearance="header">Borders (inches)</label>
      <param name="border_1_in" type="float" min="0.0" max="50.0" precision="3" gui-text="Border 1 Width:">0.0</param>
      <param name="border_2_in" type="float" min="0.0" max="50.0" precision="3" gui-text="Border 2 Width:">0.0</param>
      <param name="border_3_in" type="float" min="0.0" max="50.0" precision="3" gui-text="Border 3 Width:">0.0</param>
      <separator/>
      <param name="binding_w_in" type="float" min="0.0" max="5.0" precision="3" gui-text="Binding Width (inches):">0.25</param>
    </page>
    <page name="options_page" gui-text="3. Options &amp; Theme">
      <param name="resize_page" type="bool" gui-text="Resize Inkscape page to fit quilt layout:">true</param>
      <param name="theme_override" type="string" gui-text="Theme override (leave blank for saved default)"></param>
    </page>
  </param>

  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Quilt Tools Pattern"/>
    </effects-menu>
  </effect>
  <script>
    <command location="extensions" interpreter="python">quilttools_new_quilt.py</command>
  </script>
</inkscape-extension>
