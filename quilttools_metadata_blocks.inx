<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>05. Text &amp; Metadata Formatter</name>
    <id>org.quilttools.fpp.metadata_blocks</id>
    
    <param name="block_text" type="string" gui-text="Text Content:"></param>
    
    <param name="block_type" type="optiongroup" appearance="combo" gui-text="Block Type:">
        <option value="step">Step Instruction</option>
        <option value="note">Note / Tip</option>
        <option value="warning">Warning / Critical</option>
        <option value="title">Section Title</option>
    </param>
    
    <param name="step_number" type="int" min="1" max="999" gui-text="Step Number (for Step type):">1</param>
    
    <param name="theme_override" type="string" gui-text="Theme override (leave blank for saved default)"></param>

    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Quilt Tools Pattern"/>
        </effects-menu>
    </effect>
    <script>
        <command location="inx" interpreter="python">quilttools_metadata_blocks.py</command>
    </script>
</inkscape-extension>
