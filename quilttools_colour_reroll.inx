<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>02b. Colour Reroll (bind to a key)</name>
  <id>org.quilttools.pattern.colour_reroll</id>
  <dependency type="executable" location="extensions">quilttools_colour_random.py</dependency>

  <param name="action" type="string" gui-hidden="true">quick</param>

  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Quilt Tools Colour"/>
    </effects-menu>
  </effect>
  <script>
    <command location="extensions" interpreter="python">quilttools_colour_random.py</command>
  </script>
</inkscape-extension>
