<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>08. Import Block from SVG</name>
  <id>org.quilttoolsplugin.quilttools_fpp_import_svg</id>
  <dependency type="executable" location="extensions">quilttools_fpp_import_svg.py</dependency>

  <label appearance="header">Import arbitrary SVG block</label>
  <label>Parse an SVG containing raw shapes/pieces, import them into Quilt Tools FPP, and check for Y-seams.</label>

  <param name="svg_file" type="path" mode="file" filetypes="svg" gui-text="SVG block file"></param>
  <param name="resize_page" type="bool" gui-text="Resize page to fit imported block">true</param>

  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Quilt Tools Block"/>
    </effects-menu>
  </effect>
  <script>
    <command location="extensions" interpreter="python">quilttools_fpp_import_svg.py</command>
  </script>
</inkscape-extension>
