<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>05. FPP Display Toggle</name>
  <id>org.quilttoolsplugin.quilttools_fpp_display</id>
  <dependency type="executable" location="extensions">quilttools_fpp_display.py</dependency>

  <label appearance="header">FPP Display Toggle</label>
  <label>Click Apply to instantly alternate between your Block Colours (saved fabric palette) and the Section Colour Overlay (colour-coded by Section A, B, C...).</label>
  <separator/>
  <param name="mode" type="optiongroup" appearance="combo" gui-text="Display Action">
    <option value="toggle">Alternate / Toggle View (Default)</option>
    <option value="block">Show Block Colours</option>
    <option value="section">Show Section Colour Overlay</option>
  </param>
  <separator/>
  <label>Display only — your block's saved colours are never lost or overwritten.</label>

  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Quilt Tools Block"/>
    </effects-menu>
  </effect>
  <script><command location="extensions" interpreter="python">quilttools_fpp_display.py</command></script>
</inkscape-extension>
